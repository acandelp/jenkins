pipeline {
    agent any

    parameters {
        string(name: 'ACCOUNT_NUMBER', defaultValue: '', description: 'Account Number (EBS Account ID) to check all clusters')
        string(name: 'TOP_N', defaultValue: '5', description: 'Number of top consumers to report')
        choice(name: 'EXECUTION_MODE', choices: ['sequential', 'parallel'], description: 'Execute checks sequentially or in parallel')
    }

    environment {
        PATH = "${env.HOME}/.local/bin/backplane/latest:${env.HOME}/.local/bin:/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Account Number') {
            steps {
                script {
                    if (!params.ACCOUNT_NUMBER) {
                        error("ACCOUNT_NUMBER parameter is required")
                    }
                    echo "🔍 Validating Account Number: ${params.ACCOUNT_NUMBER}"
                }
            }
        }

        stage('Get Clusters from Account') {
            steps {
                script {
                    echo "📋 Retrieving all clusters for Account Number: ${params.ACCOUNT_NUMBER}"

                    sh 'chmod +x utils/*.sh scripts/*.sh'

                    // Get cluster details (cluster_id|name|state)
                    def clusterDetails = sh(
                        script: "./utils/get-clusters-by-account.sh ${params.ACCOUNT_NUMBER} details",
                        returnStdout: true
                    ).trim()

                    if (!clusterDetails) {
                        error("No clusters found for Account Number: ${params.ACCOUNT_NUMBER}")
                    }

                    def clusters = clusterDetails.split('\n').collect { line ->
                        def parts = line.split('\\|')
                        [
                            id: parts[0],
                            name: parts.size() > 1 ? parts[1] : 'UNKNOWN',
                            state: parts.size() > 2 ? parts[2] : 'UNKNOWN'
                        ]
                    }

                    // Filter only ready clusters
                    def readyClusters = clusters.findAll { it.state == 'ready' }

                    echo "✅ Found ${clusters.size()} total clusters, ${readyClusters.size()} in ready state"
                    readyClusters.each { cluster ->
                        echo "  - ${cluster.id} (${cluster.name})"
                    }

                    env.CLUSTERS_JSON = groovy.json.JsonOutput.toJson(readyClusters)
                    env.CLUSTER_COUNT = readyClusters.size().toString()
                }
            }
        }

        stage('Check Resource Consumers') {
            steps {
                script {
                    def clusters = new groovy.json.JsonSlurper().parseText(env.CLUSTERS_JSON)

                    if (clusters.isEmpty()) {
                        echo "⚠️  No ready clusters to check"
                        return
                    }

                    def checkClosure = { cluster ->
                        return {
                            stage("Check ${cluster.name} (${cluster.id})") {
                                try {
                                    echo "🔍 Checking cluster: ${cluster.name} (${cluster.id})"

                                    // Backplane login
                                    sh """
                                        export PATH=\${HOME}/.local/bin/backplane/latest:\${PATH}
                                        ocm backplane login ${cluster.id}
                                    """

                                    // Run resource consumers check
                                    def results = sh(
                                        script: "./scripts/check-resource-consumers.sh ${params.TOP_N}",
                                        returnStdout: true
                                    ).trim()

                                    if (results) {
                                        echo "ℹ️  Resource consumption report generated for ${cluster.name}"

                                        // Parse results
                                        def lines = results.split('\n')
                                        def mode = ""
                                        def cpuData = []
                                        def memData = []

                                        lines.each { line ->
                                            if (line == 'CPU') {
                                                mode = 'CPU'
                                            } else if (line == 'MEMORY') {
                                                mode = 'MEMORY'
                                            } else if (line) {
                                                def parts = line.split('\\|')
                                                if (mode == 'CPU') {
                                                    cpuData << [namespace: parts[0], value: parts[1].toFloat()]
                                                } else if (mode == 'MEMORY') {
                                                    memData << [namespace: parts[0], value: parts[1].toFloat()]
                                                }
                                            }
                                        }

                                        // Calculate totals
                                        def totalCpu = 0
                                        cpuData.each { item -> totalCpu += item.value }

                                        def totalMem = 0
                                        memData.each { item -> totalMem += item.value / 1024 / 1024 / 1024 }

                                        // Build detailed namespace lists
                                        def topCpuNamespaces = cpuData.take(3).collect {
                                            "${it.namespace} (${String.format('%.2f', it.value)} cores)"
                                        }.join(', ')

                                        def topMemNamespaces = memData.take(3).collect {
                                            "${it.namespace} (${String.format('%.2f', it.value / 1024 / 1024 / 1024)} GiB)"
                                        }.join(', ')

                                        // Format totals
                                        def cpuFormatted = String.format("%.2f", totalCpu)
                                        def memFormatted = String.format("%.2f", totalMem)

                                        def message = "[${cluster.name}] Resource consumption report (current usage): Top ${params.TOP_N} namespaces consuming ${cpuFormatted} CPU cores and ${memFormatted} GiB memory. Highest CPU consumers: ${topCpuNamespaces}. Highest memory consumers: ${topMemNamespaces}. This is an informational snapshot for capacity planning."

                                        echo message

                                        // Write and send service log
                                        writeFile file: "service-log-${cluster.id}.txt", text: message

                                        sh """
                                            cat service-log-${cluster.id}.txt | ./utils/send-service-log.sh '${cluster.id}' 'Low' 'Resource Consumption Report'
                                        """

                                        echo "✅ Report sent for ${cluster.name}"
                                    } else {
                                        echo "⚠️  No resource consumption data for ${cluster.name}"

                                        def message = "[${cluster.name}] Resource consumption metrics are temporarily unavailable. This may be due to metrics server initialization or recent cluster deployment. Metrics collection continues normally and data will be available in the next check. No action required."

                                        writeFile file: "service-log-${cluster.id}.txt", text: message

                                        sh """
                                            cat service-log-${cluster.id}.txt | ./utils/send-service-log.sh '${cluster.id}' 'Low' 'Resource Consumption Data Unavailable'
                                        """
                                    }

                                    // Backplane logout
                                    sh """
                                        export PATH=\${HOME}/.local/bin/backplane/latest:\${PATH}
                                        ocm backplane logout || true
                                    """

                                } catch (Exception e) {
                                    echo "❌ Error checking cluster ${cluster.name}: ${e.message}"

                                    // Ensure logout on error
                                    sh """
                                        export PATH=\${HOME}/.local/bin/backplane/latest:\${PATH}
                                        ocm backplane logout || true
                                    """

                                    // Don't fail the whole pipeline, continue with other clusters
                                    unstable("Failed to check cluster ${cluster.name}")
                                }
                            }
                        }
                    }

                    // Execute checks based on mode
                    if (params.EXECUTION_MODE == 'parallel') {
                        echo "⚡ Running checks in parallel for ${clusters.size()} clusters"
                        def parallelStages = [:]
                        clusters.each { cluster ->
                            parallelStages["${cluster.name}"] = checkClosure(cluster)
                        }
                        parallel parallelStages
                    } else {
                        echo "🔄 Running checks sequentially for ${clusters.size()} clusters"
                        clusters.each { cluster ->
                            checkClosure(cluster).call()
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh '''
                    export PATH=${HOME}/.local/bin/backplane/latest:${PATH}
                    ocm backplane logout || true
                '''
                echo "🔒 All Backplane sessions closed"
            }
        }
        failure {
            echo "❌ Pipeline failed - check individual cluster logs"
        }
        success {
            echo "✅ Resource consumption reports completed for all clusters in Account ${params.ACCOUNT_NUMBER}"
        }
    }
}
