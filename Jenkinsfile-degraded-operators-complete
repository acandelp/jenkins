pipeline {
    agent any

    parameters {
        string(name: 'CLUSTER_ID', defaultValue: '', description: 'Cluster ID to check')
        string(name: 'CLUSTER_API_URL', defaultValue: '', description: 'Cluster API URL (e.g., https://api.cluster.example.com:6443)')
        string(name: 'LOOKBACK_DAYS', defaultValue: '6', description: 'Days to look back')
    }

    environment {
        // Path to kubeconfig (will be set from credentials)
        KUBECONFIG = "${WORKSPACE}/.kube/config"
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.CLUSTER_ID) {
                        error("CLUSTER_ID parameter is required")
                    }
                    echo "✓ Cluster ID: ${params.CLUSTER_ID}"
                    echo "✓ Lookback Days: ${params.LOOKBACK_DAYS}"
                }
            }
        }

        stage('Setup Authentication') {
            steps {
                script {
                    echo "Setting up cluster authentication..."

                    // Create .kube directory
                    sh 'mkdir -p ${WORKSPACE}/.kube'

                    // Option 1: Using kubeconfig file credential
                    withCredentials([file(credentialsId: 'cluster-kubeconfig', variable: 'KUBECONFIG_FILE')]) {
                        sh 'cp $KUBECONFIG_FILE ${KUBECONFIG}'
                    }

                    /* Option 2: Using token credential (uncomment if using this method)
                    withCredentials([string(credentialsId: 'cluster-token', variable: 'CLUSTER_TOKEN')]) {
                        sh """
                            oc login ${params.CLUSTER_API_URL} --token=\${CLUSTER_TOKEN} --insecure-skip-tls-verify=true
                        """
                    }
                    */

                    // Setup OCM authentication
                    withCredentials([string(credentialsId: 'ocm-token', variable: 'OCM_TOKEN')]) {
                        sh 'ocm login --token=${OCM_TOKEN}'
                    }

                    // Verify cluster access
                    sh 'oc whoami'
                    sh 'oc get clusterversion'

                    echo "✓ Authentication successful"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup Scripts') {
            steps {
                sh 'chmod +x scripts/*.sh utils/*.sh'
                sh 'ls -la scripts/ utils/'
            }
        }

        stage('Check Degraded Operators') {
            steps {
                script {
                    def results = sh(
                        script: "./scripts/check-operators.sh ${params.LOOKBACK_DAYS}",
                        returnStdout: true
                    ).trim()

                    if (results) {
                        echo "⚠️  Found degraded cluster operators"

                        // Build detailed Service Log message
                        def operatorCount = results.split('\n').size()
                        def message = """Degraded Cluster Operators Detected

SUMMARY:
Found ${operatorCount} cluster operator(s) in degraded state within the last ${params.LOOKBACK_DAYS} days.

DEGRADED OPERATORS:
"""

                        results.split('\n').each { line ->
                            def parts = line.split('\\|', 3)
                            def operatorName = parts[0]
                            def ageDays = parts[1]
                            def reason = parts[2]

                            message += """
• Operator: ${operatorName}
  Degraded Since: ${ageDays} day(s) ago
  Status: Degraded
  Reason: ${reason}
"""
                        }

                        message += """
IMPACT:
Degraded operators can cause:
- Core cluster functionality impairment
- Failed deployments or builds
- Networking issues
- Monitoring/logging gaps
- Storage provisioning failures
- Authentication problems
- Upgrade blocks (cannot upgrade with degraded operators)

DIAGNOSIS STEPS:
1. Check operator detailed status:
   'oc get clusteroperator <operator-name> -o yaml'

2. Review operator conditions:
   'oc get co <operator-name> -o jsonpath='{.status.conditions}' | jq .'

3. Check operator pods:
   'oc get pods -n openshift-<operator-namespace>'
   'oc logs <pod> -n openshift-<operator-namespace>'

4. Review cluster events:
   'oc get events -A --sort-by=.lastTimestamp | grep <operator-name>'

COMMON DEGRADED OPERATORS & FIXES:

• authentication operator:
  - Check OAuth pods: 'oc get pods -n openshift-authentication'
  - Verify OAuth configuration: 'oc get oauth cluster -o yaml'

• console operator:
  - Check console pods: 'oc get pods -n openshift-console'
  - Verify route: 'oc get route -n openshift-console'

• ingress operator:
  - Check router pods: 'oc get pods -n openshift-ingress'
  - Verify IngressController: 'oc get ingresscontroller -n openshift-ingress-operator'

• monitoring operator:
  - Check Prometheus pods: 'oc get pods -n openshift-monitoring'
  - Verify PVCs: 'oc get pvc -n openshift-monitoring'

• network operator:
  - Check network pods: 'oc get pods -n openshift-network-operator'
  - Verify network config: 'oc get network.config cluster -o yaml'

RECOMMENDED ACTIONS:
1. Investigate root cause using diagnosis steps above
2. Review recent cluster changes (upgrades, configuration)
3. Check resource availability (CPU, memory, storage)
4. Restart degraded operator pods if needed:
   'oc delete pod <pod> -n <namespace>'
5. Escalate to Red Hat Support if issue persists

CLUSTER HEALTH:
Degraded operators should be resolved before attempting cluster upgrades or major changes.

SEVERITY: Warning
Requires immediate investigation to ensure cluster stability.
"""

                        echo message

                        sh """
                            ./utils/send-service-log.sh \\
                                '${params.CLUSTER_ID}' \\
                                'Warning' \\
                                'Degraded Cluster Operators (${operatorCount} affected)' \\
                                '${message.replaceAll("'", "'\\''")}'
                        """

                        currentBuild.result = 'UNSTABLE'
                        currentBuild.description = "⚠️ ${operatorCount} degraded operator(s) found"
                    } else {
                        echo "✅ No degraded operators in last ${params.LOOKBACK_DAYS} days"
                        currentBuild.result = 'SUCCESS'
                        currentBuild.description = "✅ No degraded operators"
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                echo "Job Summary:"
                echo "  Cluster: ${params.CLUSTER_ID}"
                echo "  Status: ${currentBuild.result}"
                echo "  Duration: ${currentBuild.durationString}"
                echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            }

            // Cleanup kubeconfig
            sh 'rm -f ${KUBECONFIG}'
        }

        failure {
            script {
                echo "❌ Pipeline failed - check logs for errors"
                currentBuild.description = "❌ Pipeline failed"

                // Optional: Send notification to Slack/Email
                // slackSend(channel: '#ops-alerts', message: "Degraded Operators check failed for cluster ${params.CLUSTER_ID}")
            }
        }

        success {
            echo "✅ Degraded operator check completed successfully"
        }

        unstable {
            echo "⚠️  Degraded operators detected - Service Log sent to customer"
        }
    }
}
