pipeline {
    agent any

    parameters {
        string(name: 'CLUSTER_ID', defaultValue: '', description: 'Cluster ID to check')
    }

    environment {
        PATH = "${env.HOME}/.local/bin/backplane/latest:${env.HOME}/.local/bin:/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backplane Login') {
            steps {
                script {
                    echo "Setting up Backplane authentication..."

                    if (!params.CLUSTER_ID) {
                        error("CLUSTER_ID parameter is required")
                    }

                    sh """
                        export PATH=\${HOME}/.local/bin/backplane/latest:\${PATH}
                        ocm backplane login ${params.CLUSTER_ID}
                    """

                    echo "✅ Backplane login successful"
                }
            }
        }

        stage('Setup') {
            steps {
                sh 'chmod +x scripts/*.sh utils/*.sh'
            }
        }

        stage('Check Degraded Operators') {
            steps {
                script {
                    def results = sh(
                        script: "./scripts/check-operators.sh",
                        returnStdout: true
                    ).trim()

                    if (results) {
                        echo "⚠️  Found degraded cluster operators"

                        // Build customer-friendly Service Log message - single line
                        def operatorCount = results.split('\n').size()
                        def operatorDetails = []

                        results.split('\n').each { line ->
                            def parts = line.split('\\|', 2)
                            def operatorName = parts[0]
                            def reason = parts.size() > 1 ? parts[1] : "Unknown reason"
                            operatorDetails << "${operatorName}"
                        }

                        def message = "Detected ${operatorCount} degraded cluster operator(s): ${operatorDetails.join(', ')}. Our SRE team is investigating. If you experience issues with your applications, please open a support case."

                        echo message

                        // Write message to temporary file to avoid argument length issues
                        writeFile file: 'service-log-message.txt', text: message

                        sh """
                            cat service-log-message.txt | ./utils/send-service-log.sh '${params.CLUSTER_ID}' 'Moderate' 'Cluster Operators Degraded (${operatorCount})'
                        """

                        currentBuild.result = 'UNSTABLE'
                    } else {
                        echo "✅ No degraded operators found"

                        // Build positive Service Log message - single line
                        def message = "All cluster operators are healthy and functioning normally. No degraded operators detected. No action required."

                        echo message

                        // Write message to temporary file to avoid argument length issues
                        writeFile file: 'service-log-message.txt', text: message

                        sh """
                            cat service-log-message.txt | ./utils/send-service-log.sh '${params.CLUSTER_ID}' 'Low' 'Cluster Operators Healthy'
                        """

                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                // Cleanup: Logout from backplane
                sh '''
                    export PATH=${HOME}/.local/bin/backplane/latest:${PATH}
                    ocm backplane logout || true
                '''
                echo "🔒 Backplane session closed"
            }
        }
        failure {
            echo "❌ Pipeline failed - check cluster access"
        }
        success {
            echo "✅ Cluster operator check completed successfully"
        }
    }
}
