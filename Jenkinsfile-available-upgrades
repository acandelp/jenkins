pipeline {
    agent any

    parameters {
        string(name: 'CLUSTER_ID', defaultValue: '', description: 'Cluster ID to check')
    }

    environment {
        PATH = "${env.HOME}/.local/bin/backplane/latest:${env.HOME}/.local/bin:/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backplane Login') {
            steps {
                script {
                    echo "Setting up Backplane authentication..."
                    if (!params.CLUSTER_ID) {
                        error("CLUSTER_ID parameter is required")
                    }
                    sh """
                        export PATH=\${HOME}/.local/bin/backplane/latest:\${PATH}
                        ocm backplane login ${params.CLUSTER_ID}
                    """
                    echo "✅ Backplane login successful"
                }
            }
        }

        stage('Setup') {
            steps {
                sh 'chmod +x scripts/*.sh utils/*.sh'
            }
        }

        stage('Check Available Upgrades') {
            steps {
                script {
                    def results = sh(
                        script: "./scripts/check-upgrades.sh",
                        returnStdout: true
                    ).trim()

                    if (results) {
                        echo "ℹ️  Cluster upgrades available"

                        // Parse results
                        def currentVersion = ""
                        def channel = ""
                        def upgrades = []

                        results.split('\n').each { line ->
                            def parts = line.split('\\|')
                            if (parts[0] == 'CURRENT') {
                                currentVersion = parts[1]
                            } else if (parts[0] == 'CHANNEL') {
                                channel = parts[1]
                            } else if (parts[0] == 'AVAILABLE') {
                                upgrades << parts[1]
                            }
                        }

                        // Build customer-friendly Service Log message
                        def upgradeList = upgrades.collect { "  • ${it}" }.join('\n')

                        def message = """A new OpenShift version is available for your cluster.

Current version: ${currentVersion}
Available upgrade(s):
${upgradeList}

This upgrade includes security patches, bug fixes, and new features. If you would like to schedule an upgrade, please open a support case and we will coordinate a maintenance window with you.

No immediate action is required.
"""

                        echo message

                        sh """
                            // Write message to temporary file to avoid argument length issues
                            writeFile file: 'service-log-message.txt', text: message

                            sh """
                                cat service-log-message.txt | ./utils/send-service-log.sh '\${params.CLUSTER_ID}' 'Low' 'Cluster Upgrade Available: ${currentVersion} → ${upgrades[0]}'
                            """
                        """

                        currentBuild.result = 'SUCCESS'
                    } else {
                        echo "✅ No upgrades available - cluster is up to date"

                        // Get current version for the message
                        def currentVersion = sh(
                            script: 'oc get clusterversion version -o jsonpath=\'{.status.desired.version}\'',
                            returnStdout: true
                        ).trim()

                        def channel = sh(
                            script: 'oc get clusterversion version -o jsonpath=\'{.spec.channel}\'',
                            returnStdout: true
                        ).trim()

                        // Build customer-friendly Service Log message
                        def message = """Your cluster is running the latest available version (${currentVersion}).

No new upgrades are currently available. We will notify you when new OpenShift versions become available for your cluster.

No action is required.
"""

                        echo message

                        sh """
                            // Write message to temporary file to avoid argument length issues
                            writeFile file: 'service-log-message.txt', text: message

                            sh """
                                cat service-log-message.txt | ./utils/send-service-log.sh '\${params.CLUSTER_ID}' 'Low' 'Cluster Version Status - Up to Date'
                            """
                        """

                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh '''
                    export PATH=${HOME}/.local/bin/backplane/latest:${PATH}
                    ocm backplane logout || true
                '''
                echo "🔒 Backplane session closed"
            }
        }
        failure {
            echo "❌ Pipeline failed - check cluster access"
        }
        success {
            echo "✅ Upgrade availability check completed successfully"
        }
    }
}
