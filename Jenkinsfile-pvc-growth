pipeline {
    agent any

    parameters {
        string(name: 'CLUSTER_ID', defaultValue: '', description: 'Cluster ID to check')
        string(name: 'GROWTH_THRESHOLD', defaultValue: '20', description: 'Growth % threshold (6 days)')
    }

    environment {
        PATH = "${env.HOME}/.local/bin/backplane/latest:${env.HOME}/.local/bin:/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backplane Login') {
            steps {
                script {
                    echo "Setting up Backplane authentication..."
                    if (!params.CLUSTER_ID) {
                        error("CLUSTER_ID parameter is required")
                    }
                    sh """
                        export PATH=\${HOME}/.local/bin/backplane/latest:\${PATH}
                        ocm backplane login ${params.CLUSTER_ID}
                    """
                    echo "✅ Backplane login successful"
                }
            }
        }

        stage('Setup') {
            steps {
                sh 'chmod +x scripts/*.sh utils/*.sh'
            }
        }

        stage('Check PVC Growth') {
            steps {
                script {
                    def results = sh(
                        script: "./scripts/check-pvc-growth.sh ${params.GROWTH_THRESHOLD}",
                        returnStdout: true
                    ).trim()

                    if (results) {
                        echo "⚠️  Found PVCs with high growth rate"

                        // Build detailed Service Log message
                        def pvcCount = results.split('\n').size()
                        def message = """Persistent Volume Growth Alert

SUMMARY:
Detected ${pvcCount} PersistentVolumeClaim(s) with growth exceeding ${params.GROWTH_THRESHOLD}% over the last 6 days.

PVCs WITH HIGH GROWTH:
"""

                        results.split('\n').each { line ->
                            def parts = line.split('\\|')
                            def namespace = parts[0]
                            def pvcName = parts[1]
                            def growthPercent = parts[2].toFloat().round(2)

                            message += """
• Namespace: ${namespace}
  PVC: ${pvcName}
  Growth Rate: ${growthPercent}% (6-day period)
  Projection: ~${(growthPercent * 30 / 6).round(2)}% per month
"""
                        }

                        message += """
IMPACT:
Rapid PVC growth can lead to:
- Storage capacity exhaustion
- Pod eviction due to disk pressure
- Application failures when PVC reaches 100% capacity
- Potential data loss if applications cannot write

RECOMMENDED ACTIONS:
1. Review application logs in affected namespaces for unusual activity
2. Identify source of data growth (logs, temp files, database growth)
3. Evaluate if PVC resize is needed: 'oc set volume' or edit PVC
4. Consider implementing data retention/cleanup policies
5. Monitor PVC usage trends: 'oc get pvc -n <namespace>'

CAPACITY PLANNING:
Based on current growth rate, estimate when PVC will reach capacity and plan expansion accordingly.

SEVERITY: Warning
Proactive monitoring to prevent storage-related outages.
"""

                        echo message

                        sh """
                            // Write message to temporary file to avoid argument length issues
                            writeFile file: 'service-log-message.txt', text: message

                            sh """
                                cat service-log-message.txt | ./utils/send-service-log.sh '\${params.CLUSTER_ID}' 'Warning' 'High PVC Growth Detected (${pvcCount} affected)'
                            """
                        """

                        currentBuild.result = 'UNSTABLE'
                    } else {
                        echo "✅ No PVCs with growth > ${params.GROWTH_THRESHOLD}%"

                        // Build positive Service Log message
                        def message = """Storage Growth Health Check - Normal Growth Patterns

SUMMARY:
All Persistent Volume Claims (PVCs) are showing normal growth patterns. No PVCs with excessive growth (>${params.GROWTH_THRESHOLD}%) detected in the last 6 days.

STORAGE STATUS:
✅ All PVCs growing at normal rates (<${params.GROWTH_THRESHOLD}% per 6 days)
✅ No capacity concerns detected
✅ No immediate storage expansion required

VERIFICATION PERFORMED:
• Analyzed PVC growth trends over 6-day period using Prometheus metrics
• Compared current usage against historical data
• Verified growth rates are within acceptable thresholds

CAPACITY PLANNING:
• Current growth patterns are sustainable
• No storage bottlenecks anticipated in near term
• Regular monitoring continues to track usage trends

NEXT STEPS:
✅ No action required - storage growth is normal
✅ Continue regular monitoring
✅ Next automated check will run in 6 days

MONITORING DETAILS:
• Check Type: Automated Storage Growth Analysis
• Growth Threshold: ${params.GROWTH_THRESHOLD}%
• Analysis Period: 6 days
• Check Date: ${new Date().format('yyyy-MM-dd HH:mm:ss')} UTC
• Next Check: Scheduled in 6 days

SEVERITY: Info
This is a routine storage health confirmation. No growth concerns detected.
"""

                        echo message

                        sh """
                            // Write message to temporary file to avoid argument length issues
                            writeFile file: 'service-log-message.txt', text: message

                            sh """
                                cat service-log-message.txt | ./utils/send-service-log.sh '\${params.CLUSTER_ID}' 'Low' 'Storage Growth Health Check - Normal Growth Patterns'
                            """
                        """

                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh '''
                    export PATH=${HOME}/.local/bin/backplane/latest:${PATH}
                    ocm backplane logout || true
                '''
                echo "🔒 Backplane session closed"
            }
        }
        failure {
            echo "❌ Pipeline failed - check Prometheus access and metrics availability"
        }
        success {
            echo "✅ PVC growth check completed successfully"
        }
    }
}
