pipeline {
    agent any

    parameters {
        string(name: 'CLUSTER_ID', defaultValue: '', description: 'Cluster ID to check')
        string(name: 'DAYS_WARNING', defaultValue: '60', description: 'Days before expiry to warn')
    }

    environment {
        PATH = "${env.HOME}/.local/bin/backplane/latest:${env.HOME}/.local/bin:/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backplane Login') {
            steps {
                script {
                    echo "Setting up Backplane authentication..."
                    if (!params.CLUSTER_ID) {
                        error("CLUSTER_ID parameter is required")
                    }
                    sh """
                        export PATH=\${HOME}/.local/bin/backplane/latest:\${PATH}
                        ocm backplane login ${params.CLUSTER_ID}
                    """
                    echo "✅ Backplane login successful"
                }
            }
        }

        stage('Setup') {
            steps {
                sh 'chmod +x scripts/*.sh utils/*.sh'
            }
        }

        stage('Check Certificates') {
            steps {
                script {
                    def results = sh(
                        script: "./scripts/check-certificates.sh ${params.DAYS_WARNING}",
                        returnStdout: true
                    ).trim()

                    if (results) {
                        echo "⚠️  Found certificates expiring soon"

                        // Build customer-friendly Service Log message - single line
                        def certCount = results.split('\n').size()
                        def certDetails = []

                        results.split('\n').each { line ->
                            def parts = line.split('\\|')
                            def namespace = parts[0]
                            def secretName = parts[1]
                            def daysLeft = parts[2]
                            certDetails << "${namespace}/${secretName} (expires in ${daysLeft} days)"
                        }

                        def message = "Found ${certCount} SSL/TLS certificate(s) expiring within ${params.DAYS_WARNING} days: ${certDetails.join(', ')}. Please renew before expiration to prevent service interruptions. Open a support case if you need assistance."

                        echo message

                        // Write message to temporary file to avoid argument length issues
                        writeFile file: 'service-log-message.txt', text: message

                        sh """
                            cat service-log-message.txt | ./utils/send-service-log.sh '${params.CLUSTER_ID}' 'Warning' 'SSL/TLS Certificates Expiring Soon (${certCount} found)'
                        """

                        currentBuild.result = 'UNSTABLE'
                    } else {
                        echo "✅ No certificates expiring in the next ${params.DAYS_WARNING} days"

                        // Build customer-friendly Service Log message - single line
                        def message = "All SSL/TLS certificates are valid. No certificates expiring within the next ${params.DAYS_WARNING} days. No action required."

                        echo message

                        sh """
                            // Write message to temporary file to avoid argument length issues
                            writeFile file: 'service-log-message.txt', text: message

                            sh """
                                cat service-log-message.txt | ./utils/send-service-log.sh '\${params.CLUSTER_ID}' 'Low' 'SSL/TLS Certificate Health Check - All Certificates Valid'
                            """
                        """

                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh '''
                    export PATH=${HOME}/.local/bin/backplane/latest:${PATH}
                    ocm backplane logout || true
                '''
                echo "🔒 Backplane session closed"
            }
        }
        failure {
            echo "❌ Pipeline failed - check logs for errors"
        }
        success {
            echo "✅ Certificate check completed successfully"
        }
    }
}
