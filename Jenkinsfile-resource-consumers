pipeline {
    agent any

    parameters {
        string(name: 'CLUSTER_ID', defaultValue: '', description: 'Cluster ID to check')
        string(name: 'TOP_N', defaultValue: '5', description: 'Number of top consumers to report')
    }

    environment {
        PATH = "${env.HOME}/.local/bin/backplane/latest:${env.HOME}/.local/bin:/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backplane Login') {
            steps {
                script {
                    echo "Setting up Backplane authentication..."
                    if (!params.CLUSTER_ID) {
                        error("CLUSTER_ID parameter is required")
                    }
                    sh """
                        export PATH=\${HOME}/.local/bin/backplane/latest:\${PATH}
                        ocm backplane login ${params.CLUSTER_ID}
                    """
                    echo "✅ Backplane login successful"
                }
            }
        }

        stage('Setup') {
            steps {
                sh 'chmod +x scripts/*.sh utils/*.sh'
            }
        }

        stage('Check Top Resource Consumers') {
            steps {
                script {
                    def results = sh(
                        script: "./scripts/check-resource-consumers.sh ${params.TOP_N}",
                        returnStdout: true
                    ).trim()

                    if (results) {
                        echo "ℹ️  Resource consumption report generated"

                        // Parse results
                        def lines = results.split('\n')
                        def mode = ""
                        def cpuData = []
                        def memData = []

                        lines.each { line ->
                            if (line == 'CPU') {
                                mode = 'CPU'
                            } else if (line == 'MEMORY') {
                                mode = 'MEMORY'
                            } else if (line) {
                                def parts = line.split('\\|')
                                if (mode == 'CPU') {
                                    cpuData << [namespace: parts[0], value: parts[1].toFloat()]
                                } else if (mode == 'MEMORY') {
                                    memData << [namespace: parts[0], value: parts[1].toFloat()]
                                }
                            }
                        }

                        // Build customer-friendly Service Log message - single line
                        def totalCpu = 0
                        cpuData.each { item -> totalCpu += item.value }

                        def totalMem = 0
                        memData.each { item -> totalMem += item.value / 1024 / 1024 / 1024 }

                        // Build detailed namespace lists with individual consumption values
                        def topCpuNamespaces = cpuData.take(3).collect {
                            "${it.namespace} (${String.format('%.2f', it.value)} cores)"
                        }.join(', ')

                        def topMemNamespaces = memData.take(3).collect {
                            "${it.namespace} (${String.format('%.2f', it.value / 1024 / 1024 / 1024)} GiB)"
                        }.join(', ')

                        // Format total numbers with 2 decimal places using String.format (sandbox-safe)
                        def cpuFormatted = String.format("%.2f", totalCpu)
                        def memFormatted = String.format("%.2f", totalMem)

                        def message = "Resource consumption report (current usage): Top ${params.TOP_N} namespaces consuming ${cpuFormatted} CPU cores and ${memFormatted} GiB memory. Highest CPU consumers: ${topCpuNamespaces}. Highest memory consumers: ${topMemNamespaces}. This is an informational snapshot for capacity planning."

                        echo message

                        // Write message to temporary file to avoid argument length issues
                        writeFile file: 'service-log-message.txt', text: message

                        sh """
                            cat service-log-message.txt | ./utils/send-service-log.sh '${params.CLUSTER_ID}' 'Low' 'Resource Consumption Report'
                        """

                        currentBuild.result = 'SUCCESS'
                    } else {
                        echo "⚠️  No resource consumption data available"

                        // Build customer-friendly Service Log message - single line
                        def message = "Resource consumption metrics are temporarily unavailable. This may be due to metrics server initialization or recent cluster deployment. Metrics collection continues normally and data will be available in the next check. No action required."

                        echo message

                        // Write message to temporary file to avoid argument length issues
                        writeFile file: 'service-log-message.txt', text: message

                        sh """
                            cat service-log-message.txt | ./utils/send-service-log.sh '${params.CLUSTER_ID}' 'Low' 'Resource Consumption Data Unavailable'
                        """

                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh '''
                    export PATH=${HOME}/.local/bin/backplane/latest:${PATH}
                    ocm backplane logout || true
                '''
                echo "🔒 Backplane session closed"
            }
        }
        failure {
            echo "❌ Pipeline failed - check Prometheus access"
        }
        success {
            echo "✅ Resource consumption report completed successfully"
        }
    }
}
