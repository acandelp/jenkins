pipeline {
    agent any

    parameters {
        string(name: 'CLUSTER_ID', defaultValue: '', description: 'Cluster ID to check')
        string(name: 'USAGE_THRESHOLD', defaultValue: '85', description: 'Usage % threshold')
    }

    environment {
        PATH = "${env.HOME}/.local/bin/backplane/latest:${env.HOME}/.local/bin:/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backplane Login') {
            steps {
                script {
                    echo "Setting up Backplane authentication..."
                    if (!params.CLUSTER_ID) {
                        error("CLUSTER_ID parameter is required")
                    }
                    sh """
                        export PATH=\${HOME}/.local/bin/backplane/latest:\${PATH}
                        ocm backplane login ${params.CLUSTER_ID}
                    """
                    echo "✅ Backplane login successful"
                }
            }
        }

        stage('Setup') {
            steps {
                sh 'chmod +x scripts/*.sh utils/*.sh'
            }
        }

        stage('Check Resource Quotas') {
            steps {
                script {
                    def results = sh(
                        script: "./scripts/check-quotas.sh ${params.USAGE_THRESHOLD}",
                        returnStdout: true
                    ).trim()

                    if (results) {
                        echo "⚠️  Found quotas approaching limits"

                        // Build detailed Service Log message
                        def quotaCount = results.split('\n').size()
                        def message = """Resource Quota Approaching Limit

SUMMARY:
Found ${quotaCount} resource quota(s) exceeding ${params.USAGE_THRESHOLD}% capacity.

QUOTAS NEAR LIMIT:
"""

                        results.split('\n').each { line ->
                            def parts = line.split('\\|')
                            def namespace = parts[0]
                            def quotaName = parts[1]
                            def resourceType = parts[2]
                            def usagePercent = parts[3]
                            def used = parts[4]
                            def hard = parts[5]

                            message += """
• Namespace: ${namespace}
  Quota Name: ${quotaName}
  Resource: ${resourceType}
  Usage: ${usagePercent}% (${used} of ${hard})
  Remaining: ${hard.replaceAll('[^0-9]', '').toInteger() - used.replaceAll('[^0-9]', '').toInteger()}
"""
                        }

                        message += """
IMPACT:
When quotas reach 100%:
- New pods will fail to schedule with 'quota exceeded' errors
- Deployments will be stuck in pending state
- Applications cannot scale horizontally
- Service degradation or complete outage possible

RECOMMENDED ACTIONS:
1. Contact namespace owners to review resource usage
2. Evaluate if quota increase is justified:
   - Check current usage: 'oc describe quota -n <namespace>'
   - Review pod resource requests/limits
3. Optimize resource requests if over-provisioned
4. Consider horizontal pod autoscaling limits
5. Update quota if legitimate growth:
   'oc patch resourcequota <name> -n <namespace> --patch=...'

QUOTA MANAGEMENT:
Resource quotas prevent runaway resource consumption but must be sized appropriately for workload needs.

SEVERITY: Warning
Action required to prevent deployment failures.
"""

                        echo message

                        sh """
                            ./utils/send-service-log.sh \\
                                '${params.CLUSTER_ID}' \\
                                'Warning' \\
                                'Resource Quotas Approaching Limits (${quotaCount} affected)' \\
                                '${message.replaceAll("'", "'\\''")}'
                        """

                        currentBuild.result = 'UNSTABLE'
                    } else {
                        echo "✅ All quotas below ${params.USAGE_THRESHOLD}%"

                        // Build positive Service Log message
                        def message = """Resource Quota Health Check - All Quotas Healthy

SUMMARY:
All resource quotas are operating within healthy ranges. No quotas exceeding ${params.USAGE_THRESHOLD}% capacity detected.

QUOTA STATUS:
✅ All resource quotas below ${params.USAGE_THRESHOLD}% threshold
✅ Sufficient capacity available for workload scaling
✅ No deployment failures anticipated due to quota limits

VERIFICATION PERFORMED:
• Checked all ResourceQuota objects across all namespaces
• Compared used resources against hard limits
• Verified quotas have adequate headroom for operations

CAPACITY OVERVIEW:
• Current usage levels are sustainable
• Namespaces have room to scale workloads
• No quota adjustments needed at this time

NEXT STEPS:
✅ No action required - all quotas are healthy
✅ Continue regular monitoring
✅ Next automated check will run in 6 days

MONITORING DETAILS:
• Check Type: Automated Resource Quota Check
• Usage Threshold: ${params.USAGE_THRESHOLD}%
• Check Date: ${new Date().format('yyyy-MM-dd HH:mm:ss')} UTC
• Next Check: Scheduled in 6 days

SEVERITY: Info
This is a routine quota health confirmation. No capacity concerns detected.
"""

                        echo message

                        sh """
                            ./utils/send-service-log.sh \\
                                '${params.CLUSTER_ID}' \\
                                'Info' \\
                                'Resource Quota Health Check - All Quotas Healthy' \\
                                '${message.replaceAll("'", "'\\''")}'
                        """

                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh '''
                    export PATH=${HOME}/.local/bin/backplane/latest:${PATH}
                    ocm backplane logout || true
                '''
                echo "🔒 Backplane session closed"
            }
        }
        failure {
            echo "❌ Pipeline failed - check cluster access"
        }
        success {
            echo "✅ Resource quota check completed successfully"
        }
    }
}
