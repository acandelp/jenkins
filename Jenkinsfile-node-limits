pipeline {
    agent any

    parameters {
        string(name: 'CLUSTER_ID', defaultValue: '', description: 'Cluster ID to check')
        string(name: 'THRESHOLD', defaultValue: '100', description: 'Resource limits threshold percentage (default: 100%)')
    }

    environment {
        PATH = "${env.HOME}/.local/bin/backplane/latest:${env.HOME}/.local/bin:/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backplane Login') {
            steps {
                script {
                    echo "Setting up Backplane authentication..."

                    if (!params.CLUSTER_ID) {
                        error("CLUSTER_ID parameter is required")
                    }

                    sh """
                        export PATH=\${HOME}/.local/bin/backplane/latest:\${PATH}
                        ocm backplane login ${params.CLUSTER_ID}
                    """

                    echo "✅ Backplane login successful"
                }
            }
        }

        stage('Setup') {
            steps {
                sh 'chmod +x scripts/*.sh utils/*.sh'
            }
        }

        stage('Check Node Limits') {
            steps {
                script {
                    def results = sh(
                        script: "./scripts/check-node-limits.sh ${params.THRESHOLD}",
                        returnStdout: true
                    ).trim()

                    if (results) {
                        echo "⚠️  Found nodes with resource limits exceeding ${params.THRESHOLD}%"

                        // Parse results and build detailed message
                        def nodeCount = results.split('\n').size()
                        def nodeDetails = []

                        results.split('\n').each { line ->
                            def parts = line.split('\\|')
                            def nodeName = parts[0]
                            def cpuLimit = parts[1]
                            def memLimit = parts[2]

                            def issues = []
                            if (cpuLimit.toFloat() >= params.THRESHOLD.toFloat()) {
                                issues << "CPU: ${cpuLimit}%"
                            }
                            if (memLimit.toFloat() >= params.THRESHOLD.toFloat()) {
                                issues << "Memory: ${memLimit}%"
                            }

                            nodeDetails << "${nodeName} (${issues.join(', ')})"
                        }

                        def message = "Detected ${nodeCount} node(s) with resource limits exceeding ${params.THRESHOLD}%: ${nodeDetails.join(', ')}."

                        echo message

                        // Write message to temporary file to avoid argument length issues
                        writeFile file: 'service-log-message.txt', text: message

                        sh """
                            cat service-log-message.txt | ./utils/send-service-log.sh '${params.CLUSTER_ID}' 'Moderate' 'Node Resource Limits Exceeded (${nodeCount} node(s))'
                        """

                        currentBuild.result = 'UNSTABLE'
                    } else {
                        echo "✅ All nodes have resource limits below ${params.THRESHOLD}%"

                        // Build positive Service Log message
                        def message = "All cluster nodes have resource limits below ${params.THRESHOLD}%. Node capacity allocation is within acceptable ranges. No action required."

                        echo message

                        // Write message to temporary file to avoid argument length issues
                        writeFile file: 'service-log-message.txt', text: message

                        sh """
                            cat service-log-message.txt | ./utils/send-service-log.sh '${params.CLUSTER_ID}' 'Low' 'Node Resource Limits Healthy'
                        """

                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                // Cleanup: Logout from backplane
                sh '''
                    export PATH=${HOME}/.local/bin/backplane/latest:${PATH}
                    ocm backplane logout || true
                '''
                echo "🔒 Backplane session closed"
            }
        }
        failure {
            echo "❌ Pipeline failed - check cluster access and node availability"
        }
        success {
            echo "✅ Node limits check completed successfully"
        }
    }
}
