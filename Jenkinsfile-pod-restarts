pipeline {
    agent any

    parameters {
        string(name: 'CLUSTER_ID', defaultValue: '', description: 'Cluster ID to check')
        string(name: 'RESTART_THRESHOLD', defaultValue: '10', description: 'Restart count threshold')
    }

    environment {
        PATH = "${env.HOME}/.local/bin/backplane/latest:${env.HOME}/.local/bin:/usr/local/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backplane Login') {
            steps {
                script {
                    echo "Setting up Backplane authentication..."
                    if (!params.CLUSTER_ID) {
                        error("CLUSTER_ID parameter is required")
                    }
                    sh """
                        export PATH=\${HOME}/.local/bin/backplane/latest:\${PATH}
                        ocm backplane login ${params.CLUSTER_ID}
                    """
                    echo "✅ Backplane login successful"
                }
            }
        }

        stage('Setup') {
            steps {
                sh 'chmod +x scripts/*.sh utils/*.sh'
            }
        }

        stage('Check Pod Restarts') {
            steps {
                script {
                    def results = sh(
                        script: "./scripts/check-pod-restarts.sh ${params.RESTART_THRESHOLD}",
                        returnStdout: true
                    ).trim()

                    if (results) {
                        echo "⚠️  Found pods with frequent restarts"

                        // Build detailed Service Log message
                        def podCount = results.split('\n').size()
                        def message = """Pod Stability Issue - Frequent Restarts

SUMMARY:
Detected ${podCount} pod(s) with more than ${params.RESTART_THRESHOLD} restarts, indicating stability issues.

PODS WITH FREQUENT RESTARTS:
"""

                        results.split('\n').each { line ->
                            def parts = line.split('\\|')
                            def namespace = parts[0]
                            def podName = parts[1]
                            def restartCount = parts[2]

                            message += """
• Namespace: ${namespace}
  Pod: ${podName}
  Restart Count: ${restartCount}
  Status: Unstable
"""
                        }

                        message += """
IMPACT:
Frequent pod restarts indicate:
- Application crashes or errors
- Liveness/Readiness probe failures
- Resource constraints (OOM, CPU throttling)
- Configuration issues
- Intermittent service availability
- Degraded user experience

RECOMMENDED ACTIONS:
1. Investigate pod logs for errors:
   'oc logs <pod> -n <namespace> --previous'
   'oc logs <pod> -n <namespace> --tail=100'

2. Check pod events:
   'oc describe pod <pod> -n <namespace>'

3. Review resource usage:
   'oc adm top pod <pod> -n <namespace>'

4. Common causes to investigate:
   - Application errors in logs
   - Insufficient memory (check for OOMKilled)
   - Failed health checks (adjust probe timeouts)
   - Missing dependencies (ConfigMaps, Secrets)
   - Network connectivity issues

5. If OOMKilled, increase memory limits:
   'oc set resources deployment/<name> --limits=memory=512Mi'

6. If probe failures, adjust timing:
   - Increase initialDelaySeconds
   - Increase timeoutSeconds
   - Decrease failureThreshold

MONITORING:
Continue monitoring restart patterns to identify if issue is resolved after remediation.

SEVERITY: Warning
Requires investigation to prevent service degradation.
"""

                        echo message

                        sh """
                            ./utils/send-service-log.sh \\
                                '${params.CLUSTER_ID}' \\
                                'Warning' \\
                                'Unstable Pods - Frequent Restarts (${podCount} affected)' \\
                                '${message.replaceAll("'", "'\\''")}'
                        """

                        currentBuild.result = 'UNSTABLE'
                    } else {
                        echo "✅ No pods with > ${params.RESTART_THRESHOLD} restarts"

                        // Build positive Service Log message
                        def message = """Pod Stability Health Check - All Pods Stable

SUMMARY:
All pods are running stably with normal restart patterns. No pods with excessive restarts (>${params.RESTART_THRESHOLD}) detected.

POD STABILITY STATUS:
✅ All pods have acceptable restart counts (<${params.RESTART_THRESHOLD} restarts)
✅ No crash loops or stability issues detected
✅ Applications running reliably

VERIFICATION PERFORMED:
• Scanned all pods across all namespaces
• Checked container restart counts
• Verified no pods exhibiting instability patterns

RELIABILITY INDICATORS:
• Pod restart rates are within normal operational ranges
• No health probe failures causing excessive restarts
• No resource constraint issues leading to pod failures

NEXT STEPS:
✅ No action required - all pods are stable
✅ Continue regular monitoring
✅ Next automated check will run in 6 days

MONITORING DETAILS:
• Check Type: Automated Pod Stability Check
• Restart Threshold: ${params.RESTART_THRESHOLD} restarts
• Check Date: ${new Date().format('yyyy-MM-dd HH:mm:ss')} UTC
• Next Check: Scheduled in 6 days

SEVERITY: Info
This is a routine pod stability confirmation. No restart issues detected.
"""

                        echo message

                        sh """
                            ./utils/send-service-log.sh \\
                                '${params.CLUSTER_ID}' \\
                                'Info' \\
                                'Pod Stability Health Check - All Pods Stable' \\
                                '${message.replaceAll("'", "'\\''")}'
                        """

                        currentBuild.result = 'SUCCESS'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                sh '''
                    export PATH=${HOME}/.local/bin/backplane/latest:${PATH}
                    ocm backplane logout || true
                '''
                echo "🔒 Backplane session closed"
            }
        }
        failure {
            echo "❌ Pipeline failed - check cluster access"
        }
        success {
            echo "✅ Pod restart check completed successfully"
        }
    }
}
